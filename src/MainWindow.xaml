<Window x:Class="MetaFileExplorer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MetaFileExplorer" Height="650" Width="1050" WindowState="Maximized" Background="#F5F5F5">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        
        <!-- Sleek Icon Toolbar Button Style -->
        <Style TargetType="Button" x:Key="IconToolbarButtonStyle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MinWidth" Value="36"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E5F3FF"/>
                    <Setter Property="BorderBrush" Value="#99D1FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    
    <DockPanel Background="#F8F9FA" LastChildFill="True">
        <!-- Top Area: Clean Custom Toolbar + Address Bar -->
        <StackPanel DockPanel.Dock="Top" Background="White">
            <!-- Row 1: Action Toolbar -->
            <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="6,4">
                <DockPanel LastChildFill="False">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <!-- Navigation -->
                        <Button x:Name="BtnBack" Content="‹" Click="BtnBack_Click" Style="{StaticResource IconToolbarButtonStyle}" ToolTip="Back" FontSize="18" FontWeight="Bold"/>
                        <Button x:Name="BtnForward" Content="›" Click="BtnForward_Click" Style="{StaticResource IconToolbarButtonStyle}" ToolTip="Forward" FontSize="18" FontWeight="Bold" Margin="0,0,8,0"/>
                        
                        <Separator Width="1" Margin="4,2" Background="#D0D0D0"/>

                        <!-- File Operations -->
                        <Button Content="📁 New" Click="BtnNewFolder_Click" Style="{StaticResource IconToolbarButtonStyle}" ToolTip="New Folder" FontSize="12" FontWeight="SemiBold" MinWidth="55"/>
                        <Button Content="🗑 Delete" Click="BtnDelete_Click" Style="{StaticResource IconToolbarButtonStyle}" ToolTip="Delete Selected" FontSize="12" FontWeight="SemiBold" MinWidth="60"/>
                        
                        <Separator Width="1" Margin="4,2" Background="#D0D0D0"/>

                        <Button Content="✂ Cut" Click="BtnCut_Click" Style="{StaticResource IconToolbarButtonStyle}" ToolTip="Cut" FontSize="12" MinWidth="45"/>
                        <Button Content="📋 Copy" Click="BtnCopy_Click" Style="{StaticResource IconToolbarButtonStyle}" ToolTip="Copy" FontSize="12" MinWidth="50"/>
                        <Button Content="📄 Paste" Click="BtnPaste_Click" Style="{StaticResource IconToolbarButtonStyle}" ToolTip="Paste" FontSize="12" MinWidth="55"/>
                        <Button Content="📋+ Copy To" Click="BtnCopyTo_Click" Style="{StaticResource IconToolbarButtonStyle}" ToolTip="Copy To..." FontSize="12" MinWidth="75"/>
                        <Button Content="➔ Move To" Click="BtnMoveTo_Click" Style="{StaticResource IconToolbarButtonStyle}" ToolTip="Move To..." FontSize="12" MinWidth="70"/>
                        
                        <Separator Width="1" Margin="4,2" Background="#D0D0D0"/>

                        <!-- View Modes -->
                        <RadioButton x:Name="RbDetails" Content="Details" IsChecked="True" Checked="ViewMode_Changed" Margin="8,4" VerticalAlignment="Center" FontSize="12" FontWeight="Medium"/>
                        <RadioButton x:Name="RbThumbnails" Content="Thumbnails" Checked="ViewMode_Changed" Margin="8,4" VerticalAlignment="Center" FontSize="12" FontWeight="Medium"/>
                    </StackPanel>

                    <!-- Google-Style Instant Search Box -->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock Text="🔍" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="14"/>
                        <TextBox x:Name="TxtSearchBox" Width="180" Height="26" VerticalContentAlignment="Center" FontSize="12" Padding="4,2" TextChanged="TxtSearchBox_TextChanged" ToolTip="Type to instantly filter files..."/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Row 2: Clean Address Bar Panel -->
            <Border Background="#F1F3F5" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="8,5">
                <DockPanel LastChildFill="True">
                    <TextBlock Text="Path:" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold" FontSize="12" Foreground="#333"/>
                    <TextBox x:Name="TxtAddressBar" VerticalContentAlignment="Center" FontSize="12" Padding="4,3" KeyDown="TxtAddressBar_KeyDown"/>
                </DockPanel>
            </Border>
        </StackPanel>

        <!-- Bottom Status Bar -->
        <StatusBar DockPanel.Dock="Bottom" Background="#EFEFEF">
            <StatusBarItem x:Name="StatusCount" Content="0 items"/>
            <Separator/>
            <StatusBarItem x:Name="StatusSize" Content="0 MB total"/>
        </StatusBar>

        <!-- Main Split Layout -->
        <Grid Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="150"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280" MinWidth="220"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel: TreeView -->
            <DockPanel Grid.Column="0" Margin="0,0,5,0">
                <TextBlock Text="FILES &amp; FOLDERS" FontWeight="Bold" FontSize="12" Foreground="#333333" Margin="0,0,0,5" DockPanel.Dock="Top"/>
                <TreeView x:Name="FolderTree" SelectedItemChanged="FolderTree_SelectedItemChanged"/>
            </DockPanel>

            <!-- Center Panel: Details Grid or Thumbnails ListBox -->
            <Grid Grid.Column="1" Margin="5,0">
                <!-- Details View DataGrid with Multi-Select Enabled -->
                <DataGrid x:Name="FilesGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                          SelectionMode="Extended" SelectionUnit="FullRow"
                          SelectionChanged="FilesGrid_SelectionChanged"
                          MouseDoubleClick="FilesGrid_MouseDoubleClick"
                          Background="White" BorderBrush="#E0E0E0"
                          HorizontalGridLinesBrush="#E4E4E4" VerticalGridLinesBrush="#E4E4E4">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*"/>
                        <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="90"/>
                        <DataGridTextColumn Header="Modified" Binding="{Binding LastModified}" Width="135"/>
                        <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*"/>
                        <DataGridTextColumn Header="Subject" Binding="{Binding Subject}" Width="*"/>
                        <DataGridTextColumn Header="Authors" Binding="{Binding Authors}" Width="110"/>
                        <DataGridTextColumn Header="Tags" Binding="{Binding Tags}" Width="100"/>
                        <DataGridTextColumn Header="Comments" Binding="{Binding Comments}" Width="*"/>
                        <DataGridTextColumn Header="Rating" Binding="{Binding Rating}" Width="55"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Thumbnails View ListBox with Multi-Select Enabled -->
                <ListBox x:Name="ThumbnailsList" Visibility="Collapsed" SelectionMode="Extended"
                         SelectionChanged="ThumbnailsList_SelectionChanged"
                         MouseDoubleClick="ThumbnailsList_MouseDoubleClick"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         HorizontalContentAlignment="Stretch" Background="White" BorderBrush="#E0E0E0">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Width="{Binding (FrameworkElement.ActualWidth), RelativeSource={RelativeSource AncestorType=ListBox}}"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Width="120" Height="140" Margin="5" HorizontalAlignment="Center">
                                <Grid Width="100" Height="100">
                                    <!-- Actual Image Thumbnail -->
                                    <Image Source="{Binding ThumbnailImage}" Stretch="UniformToFill"
                                           Visibility="{Binding HasThumbnail, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                    <!-- Folder Badge Card -->
                                    <Border Background="{Binding CardColor}" CornerRadius="6" Padding="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                            Visibility="{Binding IsFolder, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="FOLDER" FontWeight="Bold" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- File Type Badge Card -->
                                    <Border Background="{Binding CardColor}" CornerRadius="6" Padding="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsFolder}" Value="False"/>
                                                            <Condition Binding="{Binding HasThumbnail}" Value="False"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FileExtension}" FontWeight="Bold" FontSize="15" Foreground="White" HorizontalAlignment="Center" TextAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <!-- File or Folder Name -->
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!-- Right Panel: Metadata & System Info -->
            <ScrollViewer Grid.Column="2" Margin="5,0,0,0" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="5">
                    <TextBlock Text="FILE METADATA" FontWeight="Bold" FontSize="12" Foreground="#333333" Margin="0,0,0,10"/>
                    
                    <TextBlock Text="File Name:" FontSize="11" Foreground="#555555" Margin="0,0,0,2"/>
                    <TextBox x:Name="TxtMetaFileName" Margin="0,0,0,8" Padding="3"/>

                    <TextBlock Text="Title:" FontSize="11" Foreground="#555555" Margin="0,0,0,2"/>
                    <TextBox x:Name="TxtMetaTitle" Margin="0,0,0,8" Padding="3"/>

                    <TextBlock Text="Subject:" FontSize="11" Foreground="#555555" Margin="0,0,0,2"/>
                    <TextBox x:Name="TxtMetaSubject" Margin="0,0,0,8" Padding="3"/>

                    <TextBlock Text="Authors:" FontSize="11" Foreground="#555555" Margin="0,0,0,2"/>
                    <TextBox x:Name="TxtMetaAuthors" Margin="0,0,0,8" Padding="3"/>

                    <TextBlock Text="Tags:" FontSize="11" Foreground="#555555" Margin="0,0,0,2"/>
                    <TextBox x:Name="TxtMetaTags" Margin="0,0,0,8" Padding="3"/>

                    <TextBlock Text="Comments:" FontSize="11" Foreground="#555555" Margin="0,0,0,2"/>
                    <TextBox x:Name="TxtMetaComments" Margin="0,0,0,8" Padding="3" Height="50" AcceptsReturn="True"/>

                    <TextBlock Text="Rating (1-5):" FontSize="11" Foreground="#555555" Margin="0,0,0,2"/>
                    <TextBox x:Name="TxtMetaRating" Margin="0,0,0,12" Padding="3"/>

                    <Button Content="SAVE METADATA" Click="BtnSaveMetadata_Click" Background="#1976D2" Foreground="White" FontWeight="Bold" BorderThickness="0" Padding="8" Cursor="Hand" Margin="0,0,0,15">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- System Info Read-Only Section -->
                    <Border Background="#F1F1F1" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="8">
                        <StackPanel>
                            <TextBlock Text="SYSTEM INFO" FontWeight="Bold" FontSize="11" Foreground="#666666" Margin="0,0,0,5"/>
                            <TextBlock x:Name="TxtSysPath" Text="Path: -" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="#444444" Margin="0,0,0,2"/>
                            <TextBlock x:Name="TxtSysType" Text="Type: -" FontSize="11" Foreground="#444444" Margin="0,0,0,2"/>
                            <TextBlock x:Name="TxtSysCreated" Text="Created: -" FontSize="11" Foreground="#444444" Margin="0,0,0,2"/>
                            <TextBlock x:Name="TxtSysSize" Text="Size: -" FontSize="11" Foreground="#444444"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>